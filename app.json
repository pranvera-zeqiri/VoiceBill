{
  "expo": {
    "name": "VoiceBill",
    "slug": "voicebill",
    "scheme": "voicebill",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.voicebill.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VoiceBill përdor mikrofonin për të regjistruar punën tuaj."
      }
    },
    "android": {
      "package": "com.voicebill.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": false }
  }
}